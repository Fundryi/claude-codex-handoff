{
  "name": "claude-codex-handoff",
  "version": "2.28.0",
  "private": true,
  "description": "Delegate coding tasks from Claude Code to the OpenAI Codex CLI and get the results back. Codex plugin fork with jobs that survive restarts, plus a live dashboard to watch, resume and cancel Codex runs.",
  "main": "ai-live-viewer.js",
  "scripts": {
    "start": "node ai-live-viewer.js serve",
    "stop": "node ai-live-viewer.js stop",
    "test": "node --test tests/*.test.js",
    "sync:viewer": "node scripts/sync-viewer.js"
  },
  "bin": {
    "ai-live-viewer": "ai-live-viewer.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "files": [
    "ai-live-viewer.js",
    "server/",
    "ui/",
    "assets/logo.svg",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fundryi/claude-codex-handoff.git"
  },
  "homepage": "https://github.com/Fundryi/claude-codex-handoff#readme",
  "bugs": "https://github.com/Fundryi/claude-codex-handoff/issues",
  "license": "SEE LICENSE IN LICENSE"
}
